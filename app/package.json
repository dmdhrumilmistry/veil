{
  "name": "veil-app",
  "private": true,
  "version": "0.11.1",
  "type": "module",
  "description": "Veil - private peer-to-peer end-to-end encrypted chat and file sharing",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "node e2e/two-peers.mjs",
    "test:e2e:public": "RELAY_URLS=\"wss://nos.lol wss://relay.primal.net wss://nostr.mom\" node e2e/two-peers.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "preact": "11.0.2",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "fake-indexeddb": "6.2.6",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  }
}
